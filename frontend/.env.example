# Базовый URL API. По умолчанию /api — тот же домен (в dev проксирует Vite, в проде nginx).
# Полный URL указывай, только если фронт и бэк на разных доменах (тогда на бэке нужен CORS).
VITE_API_URL=/api

# Куда dev-сервер Vite проксирует /api.
# По умолчанию http://127.0.0.1:<PORT из корневого .env> — то есть бэкенд из `cargo run`.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Для открытия в обычном браузере вне Telegram: id пользователя Telegram, от имени которого работать.
# Внутри Telegram не используется.
VITE_DEV_USER_ID=
